# Determinism contract: every text file checks out with LF so content hashes
# (spec-spine's and hqgit's own golden vectors, spec 012) are identical on every
# platform.
* text=auto eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.proto text eol=lf
*.sh text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Makefile text eol=lf

# Golden vectors are bytes; never normalize them.
*.cbor binary
*.bin binary
*.png binary

# The committed shard globs are bound to the `spec-spine-derived-regen` merge
# driver (spec 001). The driver is opt-in per clone: nothing happens until
# `./.githooks/enable-merge-driver.sh` registers it in that clone's git config.
#
# Sharding already removes the common conflict, since two PRs touching different
# specs write disjoint shard files. This covers the residual same-shard case:
# two PRs editing the same authority unit. It never replaces the staleness gate,
# which is what proves the regenerated result is what the corpus compiles to.
.derived/spec-registry/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-spec/*.json merge=spec-spine-derived-regen
.derived/codebase-index/by-package/*.json merge=spec-spine-derived-regen
.derived/codebase-index/slices.json merge=spec-spine-derived-regen
